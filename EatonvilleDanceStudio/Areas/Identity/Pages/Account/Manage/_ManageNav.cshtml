@{
    // Force the Identity area to use your main app layout
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1 class="text-neon mb-0">Manage your account</h1>
    <p class="text-light mb-4">Change your account settings</p>
    <hr class="border-neon border-2 opacity-100" />

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <!-- Main Form Area -->
        <div class="col-md-9">
            <div class="card card-dark rounded-0 border-secondary shadow-lg">
                <div class="card-body p-4">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}