@{
    // Explicitly use the root application layout
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row">
        <!-- Sidebar Navigation Pill Links -->
        <div class="col-md-3 mb-4">
            <partial name="_ManageNav" />
        </div>
        
        <!-- Form / Content Area -->
        <div class="col-md-9">
            <div class="card card-dark border-secondary rounded-0 shadow-lg">
                <div class="card-body p-4 text-light">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>
