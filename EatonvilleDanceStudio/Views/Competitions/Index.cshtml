@*
    Summary: Displays the studio's competition schedule with direct
    registration links, attendance filters, and banner toggles (#55).
*@
@model IEnumerable<EatonvilleDanceStudio.Models.Competition>

@{
    ViewData["Title"] = "Competition Itineraries & Call Times";
    bool attendingOnly = ViewBag.AttendingOnly ?? true;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-neon mb-0">
            Competition Itineraries &amp; Call Times
        </h2>
        <div class="d-flex gap-2">
            @if (attendingOnly)
            {
                <a asp-action="Index"
                   asp-route-attendingOnly="false"
                   class="btn btn-outline-neon">
                    Show Full Season Circuit
                </a>
            }
            else
            {
                <a asp-action="Index"
                   asp-route-attendingOnly="true"
                   class="btn btn-outline-neon">
                    Show Studio Attending Only
                </a>
            }

            @if (User.IsInRole("Director")
                || User.IsInRole("Instructor"))
            {
                <a asp-action="Create" class="btn btn-neon">
                    + Add Competition
                </a>
            }
        </div>
    </div>

    <div class="row">
        @foreach (EatonvilleDanceStudio.Models.Competition
            comp in Model)
        {
            string accentColor =
                string.IsNullOrWhiteSpace(comp.BrandColorHex)
                    ? "#ff10f0"
                    : comp.BrandColorHex;

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card card-neon h-100"
                     style="border-color: @accentColor !important;">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between
                                    align-items-center mb-2 flex-wrap
                                    gap-1">
                            <span class="badge border-neon text-neon">
                                @comp.EventFormat
                            </span>
                            <div class="d-flex gap-1">
                                @if (comp.IsStudioAttending)
                                {
                                    <span class="badge border-neon
                                                 text-neon">
                                        Attending
                                    </span>
                                }
                                @if (comp.IsFeaturedAnnouncement)
                                {
                                    <span class="badge text-dark"
                                          style="background-color:
                                                 @accentColor;">
                                        Featured Banner
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center
                                    gap-2 mb-2">
                            @if (!string.IsNullOrWhiteSpace(
                                comp.LogoUrl))
                            {
                                <img src="@comp.LogoUrl"
                                     alt="@comp.Name Logo"
                                     style="height: 36px;
                                            width: auto;
                                            object-fit: contain;" />
                            }
                            <h5 class="card-title mb-0">
                                @comp.Name
                            </h5>
                        </div>

                        <p class="text-light small mb-1">
                            <strong>Dates:</strong>
                            @comp.StartDate.ToString("MMM d, yyyy")
                            @if (comp.EndDate.HasValue)
                            {
                                <span>
                                    - @comp.EndDate.Value.ToString(
                                        "MMM d")
                                </span>
                            }
                        </p>

                        <p class="text-light small mb-2">
                            <strong>Location:</strong>
                            @(string.IsNullOrWhiteSpace(comp.VenueName)
                                ? "Location TBD"
                                : comp.VenueName)
                        </p>

                        @if (!string.IsNullOrWhiteSpace(comp.Notes))
                        {
                            <p class="text-muted small mb-2">
                                <strong>Notes:</strong> @comp.Notes
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            comp.RegistrationUrl))
                        {
                            <div class="mb-3">
                                <a href="@comp.RegistrationUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-outline-neon
                                          btn-sm w-100">
                                    Registration Portal &nearr;
                                </a>
                            </div>
                        }

                        <div class="mt-auto pt-2 d-flex flex-wrap
                                    gap-2">
                            <a asp-action="Details"
                               asp-route-id="@comp.Id"
                               class="btn btn-neon btn-sm
                                      flex-grow-1">
                                Itinerary (@comp.Entries.Count)
                            </a>

                            @if (User.IsInRole("Director")
                                || User.IsInRole("Instructor"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@comp.Id"
                                   class="btn btn-outline-neon btn-sm">
                                    Edit
                                </a>

                                <form asp-action="ToggleAttendance"
                                      method="post">
                                    <input type="hidden"
                                           name="id"
                                           value="@comp.Id" />
                                    <input type="hidden"
                                           name="attendingOnly"
                                           value="@attendingOnly
                                               .ToString()" />
                                    <button type="submit"
                                            class="btn btn-outline-neon
                                                   btn-sm"
                                            title="Toggle Attendance">
                                        @(comp.IsStudioAttending
                                            ? "Unattend"
                                            : "Attend")
                                    </button>
                                </form>

                                <form asp-action="ToggleFeatured"
                                      method="post">
                                    <input type="hidden"
                                           name="id"
                                           value="@comp.Id" />
                                    <input type="hidden"
                                           name="attendingOnly"
                                           value="@attendingOnly
                                               .ToString()" />
                                    <button type="submit"
                                            class="btn btn-outline-neon
                                                   btn-sm"
                                            title="Toggle Banner">
                                        @(comp.IsFeaturedAnnouncement
                                            ? "Unfeature"
                                            : "Feature")
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>