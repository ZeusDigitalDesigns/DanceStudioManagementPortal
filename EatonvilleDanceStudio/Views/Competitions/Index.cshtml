@*
    Summary: Displays the studio's competition schedule with a toggle
    between active studio-attending events and the full season circuit.
*@
@model IEnumerable<EatonvilleDanceStudio.Models.Competition>

@{
    ViewData["Title"] = "Competition Itineraries & Call Times";
    bool attendingOnly = ViewBag.AttendingOnly ?? true;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-neon mb-0">
            Competition Itineraries &amp; Call Times
        </h2>
        <div class="d-flex gap-2">
            @if (attendingOnly)
            {
                <a asp-action="Index"
                   asp-route-attendingOnly="false"
                   class="btn btn-outline-neon">
                    Show Full Season Circuit
                </a>
            }
            else
            {
                <a asp-action="Index"
                   asp-route-attendingOnly="true"
                   class="btn btn-outline-neon">
                    Show Studio Attending Only
                </a>
            }

            @if (User.IsInRole("Director")
                || User.IsInRole("Instructor"))
            {
                <a asp-action="Create" class="btn btn-neon">
                    + Add Competition
                </a>
            }
        </div>
    </div>

    <div class="row">
        @foreach (EatonvilleDanceStudio.Models.Competition
            comp in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card card-neon h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between
                                    align-items-center mb-2">
                            <span class="badge border-neon text-neon">
                                @comp.EventFormat
                            </span>
                            @if (comp.IsStudioAttending)
                            {
                                <span class="badge border-neon text-neon">
                                    Attending
                                </span>
                            }
                        </div>

                        <h5 class="card-title">@comp.Name</h5>

                        <p class="text-light small mb-1">
                            <strong>Dates:</strong>
                            @comp.StartDate.ToString("MMM d, yyyy")
                            @if (comp.EndDate.HasValue)
                            {
                                <span>
                                    - @comp.EndDate.Value.ToString("MMM d")
                                </span>
                            }
                        </p>

                        <p class="text-light small mb-2">
                            <strong>Location:</strong>
                            @(string.IsNullOrWhiteSpace(comp.VenueName)
                                ? "Location TBD"
                                : comp.VenueName)
                        </p>

                        @if (!string.IsNullOrWhiteSpace(comp.Notes))
                        {
                            <p class="text-muted small mb-3">
                                <strong>Notes:</strong> @comp.Notes
                            </p>
                        }

                        <div class="mt-auto pt-2 d-flex gap-2">
                            <a asp-action="Details"
                               asp-route-id="@comp.Id"
                               class="btn btn-neon flex-grow-1">
                                Itinerary &amp; Call Times
                                (@comp.Entries.Count)
                            </a>

                            @if (User.IsInRole("Director")
                                || User.IsInRole("Instructor"))
                            {
                                <form asp-action="ToggleAttendance"
                                      method="post">
                                    <input type="hidden"
                                           name="id"
                                           value="@comp.Id" />
                                    <input type="hidden"
                                           name="attendingOnly"
                                           value="@attendingOnly.ToString()" />
                                    <button type="submit"
                                            class="btn btn-outline-neon"
                                            title="Toggle Studio Attendance">
                                        @(comp.IsStudioAttending
                                            ? "Uncheck"
                                            : "Attend")
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>