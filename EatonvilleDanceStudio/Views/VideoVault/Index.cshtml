@*
    Summary: Displays the Choreography and Rehearsal Video Vault.
    Includes an empty-state card when no videos exist for the
    selected class filter.
*@
@model IEnumerable<EatonvilleDanceStudio.Models.RehearsalVideo>

@{
    ViewData["Title"] = "Choreography & Rehearsal Video Vault";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-neon mb-0">
            Choreography &amp; Rehearsal Video Vault
        </h2>
        @if (User.IsInRole("Director") || User.IsInRole("Instructor"))
        {
            <a asp-action="Create" class="btn btn-neon">
                + Add Practice Video
            </a>
        }
    </div>

    <!-- Class Filter Form -->
    <!-- Summary: Class filter form with an All Classes option
    plus individual class filtering. -->
    <form method="get" asp-action="Index" class="row g-2 mb-4">
        <div class="col-auto">
            <select name="danceClassId"
                    asp-items="ViewBag.ClassFilter"
                    class="form-select form-control-dark"
                    onchange="this.form.submit()">
                <option value="">-- All Classes --</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-neon">
                Filter by Class
            </button>
        </div>
    </form>

    <!-- Empty State vs. Video Grid -->
    @if (!Model.Any())
    {
        <div class="card card-neon p-5 text-center mt-3">
            <h4 class="text-neon mb-2">No Rehearsal Videos Yet</h4>
            <p class="text-light mb-4">
                There are no practice routines uploaded for this class
                selection yet.
            </p>
            @if (User.IsInRole("Director")
                || User.IsInRole("Instructor"))
            {
                <div>
                    <a asp-action="Create" class="btn btn-neon px-4">
                        + Upload First Practice Video
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            @foreach (EatonvilleDanceStudio.Models.RehearsalVideo
                video in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card card-neon h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge border-neon text-neon">
                                    @video.DanceClass?.ClassName
                                </span>
                            </div>
                            <h5 class="card-title">@video.Title</h5>
                            <p class="card-text text-light flex-grow-1">
                                @video.Description
                            </p>

                            @if (video.IsLocalFile)
                            {
                                <video class="w-100 rounded border-neon"
                                       controls
                                       preload="metadata">
                                    <source src="@video.VideoUrl"
                                            type="video/mp4" />
                                    Your browser does not support HTML5
                                    video.
                                </video>
                            }
                            else
                            {
                                <a href="@video.VideoUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-outline-neon mt-auto">
                                    Watch External Practice Video
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>