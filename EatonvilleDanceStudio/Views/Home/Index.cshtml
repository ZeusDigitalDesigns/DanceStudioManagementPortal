@model IEnumerable<EatonvilleDanceStudio.Models.FundraiserEvent>
@{
    ViewData["Title"] = "Home Page";
}

@await Component.InvokeAsync("WeatherWidget")
@await Component.InvokeAsync("CompetitionBanners")

<!-- Summary: Animated 3-Slide Hero Carousel with Ken Burns zoom effect -->
<div id="studioHeroCarousel"
     class="carousel slide carousel-fade eds-hero-carousel mb-5"
     data-bs-ride="carousel"
     data-bs-interval="5000">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#studioHeroCarousel"
                data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#studioHeroCarousel"
                data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#studioHeroCarousel"
                data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">
        <!-- Slide 1: Main Studio Welcome -->
        <div class="carousel-item active eds-hero-slide">
            <div class="eds-hero-bg"
                 style="background-image: url('https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?auto=format&fit=crop&w=1400&q=80');">
            </div>
            <div class="eds-hero-overlay">
                <span class="eds-hero-badge">
                    Eatonville's Premier Dance Family
                </span>
                <h1 class="eds-hero-title">Eatonville Dance Studio</h1>
                <p class="lead text-light mb-4" style="max-width: 640px;">
                    Where confidence meets choreography. From tiny tot
                    first steps to national competition stages, every
                    dancer has a home here.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Class" asp-action="Index"
                       class="btn btn-lg px-4 fw-bold text-white"
                       style="background-color: #ff10f0; border: none;">
                        Explore Classes
                    </a>
                    <a href="#community-events"
                       class="btn btn-lg btn-outline-light px-4">
                        Upcoming Fundraisers &amp; Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Slide 2: Competition & Stage Energy -->
        <div class="carousel-item eds-hero-slide">
            <div class="eds-hero-bg"
                 style="background-image: url('https://images.unsplash.com/photo-1518834107812-67b0b7c58434?auto=format&fit=crop&w=1400&q=80');">
            </div>
            <div class="eds-hero-overlay">
                <span class="eds-hero-badge">
                    2026–2027 Competition Season
                </span>
                <h2 class="eds-hero-title">Built for the Spotlight</h2>
                <p class="lead text-light mb-4" style="max-width: 640px;">
                    Watch our competitive teams shine across the Pacific
                    Northwest in Jazz, Hip-Hop, Contemporary, and Tap.
                </p>
                <a asp-controller="Competitions" asp-action="Index"
                   class="btn btn-lg px-4 fw-bold text-white"
                   style="background-color: #ff10f0; border: none;">
                    View Competition Schedule
                </a>
            </div>
        </div>

        <!-- Slide 3: Family, Grandparents & Community -->
        <div class="carousel-item eds-hero-slide">
            <div class="eds-hero-bg"
                 style="background-image: url('https://images.unsplash.com/photo-1547153760-18fc86324498?auto=format&fit=crop&w=1400&q=80');">
            </div>
            <div class="eds-hero-overlay">
                <span class="eds-hero-badge">
                    Open to Friends, Grandparents &amp; Neighbors
                </span>
                <h2 class="eds-hero-title">More Than a Studio</h2>
                <p class="lead text-light mb-4" style="max-width: 640px;">
                    No account needed to cheer on our dancers! Check out
                    our seasonal bake sales, fundraisers, and local
                    showcases below.
                </p>
                <a href="#community-events"
                   class="btn btn-lg px-4 fw-bold text-white"
                   style="background-color: #ff10f0; border: none;">
                    See Community Calendar
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Summary: Redesigned 3D Spotlight Feature Cards with Photography -->
<div class="row g-4 mb-5">
    <!-- Card 1: Dance Classes -->
    <div class="col-md-4">
        <div class="eds-spotlight-card">
            <div class="eds-card-img-wrap">
                <img src="https://images.unsplash.com/photo-1535525153412-5a42439a210d?auto=format&fit=crop&w=800&q=80"
                     alt="Youth and Adult Dance Classes" />
                <span class="eds-card-tag">Ages 3 to Adult</span>
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
                <h4 class="fw-bold mb-2" style="color: #ff10f0;">
                    Dance Classes
                </h4>
                <p class="text-light opacity-75 flex-grow-1">
                    High-energy Hip-Hop, classical Ballet, Acro, Jazz,
                    and Contemporary taught in a supportive, technique-first
                    environment.
                </p>
                <a asp-controller="Class" asp-action="Index"
                   class="btn btn-eds-neon w-100 mt-2 fw-bold">
                    Browse Class Schedule
                </a>
            </div>
        </div>
    </div>

    <!-- Card 2: Private Lessons -->
    <div class="col-md-4">
        <div class="eds-spotlight-card">
            <div class="eds-card-img-wrap">
                <img src="https://images.unsplash.com/photo-1504609773096-104ff2c73ba4?auto=format&fit=crop&w=800&q=80"
                     alt="One-on-One Private Dance Coaching" />
                <span class="eds-card-tag">1-on-1 Coaching</span>
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
                <h4 class="fw-bold mb-2" style="color: #ff10f0;">
                    Private Lessons
                </h4>
                <p class="text-light opacity-75 flex-grow-1">
                    Personalized solo choreography, audition prep, and
                    focused technique building tailored to your dancer's
                    exact goals.
                </p>
                <a asp-controller="PrivateLessons" asp-action="Index"
                   class="btn btn-eds-neon w-100 mt-2 fw-bold">
                    Book a Private Session
                </a>
            </div>
        </div>
    </div>

    <!-- Card 3: Studio Rentals -->
    <div class="col-md-4">
        <div class="eds-spotlight-card">
            <div class="eds-card-img-wrap">
                <img src="https://images.unsplash.com/photo-1574680096145-d05b474e2155?auto=format&fit=crop&w=800&q=80"
                     alt="Studio Floor Rentals and Events" />
                <span class="eds-card-tag">Two Rooms</span>
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
                <h4 class="fw-bold mb-2" style="color: #ff10f0;">
                    Studio Rentals
                </h4>
                <p class="text-light opacity-75 flex-grow-1">
                    Reserve our professional sprung-floor studio rooms,
                    full-wall mirrors, and sound systems for rehearsals
                    or birthday parties.
                </p>
                <a asp-controller="StudioRentals" asp-action="Index"
                   class="btn btn-eds-neon w-100 mt-2 fw-bold">
                    Check Room Availability
                </a>
            </div>
        </div>
    </div>
    <!-- Summary: Dedicated Studio Photo Gallery Slideshow below the main hero box
     with captions, prev/next controls, and smooth slide transitions. -->
    <section aria-label="Studio Photo Gallery" class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold mb-0" style="color: #ff10f0;">
                Inside Eatonville Dance Studio
            </h3>
            <span class="small text-light opacity-75">
                Classes, Recitals &amp; Studio Life
            </span>
        </div>

        <div id="studioPhotoGallery"
             class="carousel slide eds-gallery-carousel"
             data-bs-ride="carousel"
             data-bs-interval="5500">

            <div class="carousel-indicators">
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="0"
                        class="active"
                        aria-current="true"
                        aria-label="Slide 1"></button>
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="1"
                        aria-label="Slide 2"></button>
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="2"
                        aria-label="Slide 3"></button>
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="3"
                        aria-label="Slide 4"></button>
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="4"
                        aria-label="Slide 5"></button>
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="5"
                        aria-label="Slide 6"></button>
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="6"
                        aria-label="Slide 7"></button>
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="7"
                        aria-label="Slide 8"></button>
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="8"
                        aria-label="Slide 9"></button>
                <button type="button"
                        data-bs-target="#studioPhotoGallery"
                        data-bs-slide-to="9"
                        aria-label="Slide 10"></button>
            </div>

            <div class="carousel-inner">
                <!-- Slide 1 -->
                <div class="carousel-item active eds-gallery-slide">
                    <img src="/images/studio-gallery/ultradancecomp.png"
                         alt="Solo dancer holding an extension on stage" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            Competition Stage Spotlight
                        </h5>
                        <p class="small mb-0 text-white">
                            Precision, balance, and stage confidence under the
                            lights.
                        </p>
                    </div>
                </div>

                <!-- Slide 2 -->
                <div class="carousel-item eds-gallery-slide">
                    <img src="/images/studio-gallery/duo-3.png"
                         class="eds-img-pos-lower"
                         alt="Two studio dancers performing a synchronized duo" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            Partnered Expression &amp; Duos
                        </h5>
                        <p class="small mb-0 text-white">
                            Trust, timing, and emotional storytelling on stage.
                        </p>
                    </div>
                </div>

                <!-- Slide 3 -->
                <div class="carousel-item eds-gallery-slide">
                    <img src="/images/studio-gallery/group-1.png"
                         class="eds-img-pos-lower"
                         alt="Eatonville Dance Studio team group photo" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            EDS Studio Family
                        </h5>
                        <p class="small mb-0 text-white">
                            Be apart of something greater than ourselves,
                            here we are family!
                        </p>
                    </div>
                </div>

                <!-- Slide 4 -->
                <div class="carousel-item eds-gallery-slide">
                    <img src="/images/studio-gallery/group-2.png"
                         class="eds-img-pos-upper"
                         alt="Two dancers leaping together on a sandy beach" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            Pacific Northwest Spirit
                        </h5>
                        <p class="small mb-0 text-white">
                            Bringing energy, freedom, and joy everywhere we
                            dance.
                        </p>
                    </div>
                </div>

                <!-- Slide 5 -->
                <div class="carousel-item eds-gallery-slide">
                    <img src="/images/studio-gallery/group-3.png"
                         class="eds-img-pos-lower"
                         alt="Group dance routine on stage with umbrella" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            Creative Group Choreography
                        </h5>
                        <p class="small mb-0 text-white">
                            Showcasing teamwork and theatrical flair on the
                            competition floor.
                        </p>
                    </div>
                </div>

                <!-- Slide 6 -->
                <div class="carousel-item eds-gallery-slide">
                    <img src="/images/studio-gallery/group-4.png"
                         class="eds-img-pos-lower"
                         alt="Dance team in an opening formation on stage" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            Group Routine Formations
                        </h5>
                        <p class="small mb-0 text-white">
                            Months of studio rehearsals coming together as one
                            unit.
                        </p>
                    </div>
                </div>

                <!-- Slide 7 -->
                <div class="carousel-item eds-gallery-slide">
                    <img src="/images/studio-gallery/group-5.png"
                         alt="Group dancers holding a connected stage pose" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            Strength &amp; Unity on Stage
                        </h5>
                        <p class="small mb-0 text-white">
                            Supporting each other through every routine and
                            showcase.
                        </p>
                    </div>
                </div>

                <!-- Slide 8 -->
                <div class="carousel-item eds-gallery-slide">
                    <img src="/images/studio-gallery/solo-2.png"
                         class="eds-img-pos-upper"
                         alt="Soloist holding a high leg extension on stage" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            Solo Technique &amp; Grace
                        </h5>
                        <p class="small mb-0 text-white">
                            Dedicated one-on-one training shining under the
                            spotlights.
                        </p>
                    </div>
                </div>

                <!-- Slide 9 -->
                <div class="carousel-item eds-gallery-slide">
                    <img src="/images/studio-gallery/solo-6.png"
                         alt="Soloist performing a side extension on stage" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            Poise &amp; Line
                        </h5>
                        <p class="small mb-0 text-white">
                            Hard work in the studio reflected in every clean
                            line.
                        </p>
                    </div>
                </div>

                <!-- Slide 10 -->
                <div class="carousel-item eds-gallery-slide">
                    <img src="/images/studio-gallery/solo-7.png"
                         alt="Soloist mid-leap across the stage" />
                    <div class="carousel-caption eds-gallery-caption">
                        <h5 class="fw-bold mb-1" style="color: #ff10f0;">
                            Soaring Above the Stage
                        </h5>
                        <p class="small mb-0 text-white">
                            Athletic power and fearless performance energy.
                        </p>
                    </div>
                </div>
            </div>

            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#studioPhotoGallery"
                    data-bs-slide="prev">
                <span class="carousel-control-prev-icon"
                      aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#studioPhotoGallery"
                    data-bs-slide="next">
                <span class="carousel-control-next-icon"
                      aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </section>
</div>

<!-- Summary: Public Family, Grandparent & Community Fundraiser Bulletin -->
<!-- Summary: Public Family, Grandparent & Community Fundraiser Bulletin -->
<div id="community-events" class="eds-community-board mb-5">
    <div class="d-flex flex-wrap justify-content-between
                align-items-center mb-4 gap-3">
        <div>
            <span class="badge rounded-pill mb-2"
                  style="background-color: #ff10f0; color: #fff;">
                PUBLIC COMMUNITY CALENDAR 
            </span>
            <h3 class="fw-bold text-white mb-1">
                Family Events, Bake Sales &amp; Fundraisers
            </h3>
            <p class="text-light opacity-75 mb-0">
                Grandparents, neighbors, and friends—come cheer on our
                dancers and support their road to Nationals!
            </p>
        </div>

        @if (User.IsInRole("Director") || User.IsInRole("Admin"))
        {
            <a asp-controller="Fundraisers"
               asp-action="Index"
               class="btn btn-eds-neon btn-sm">
                Manage Fundraisers
            </a>
        }
    </div>

    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            @foreach (EatonvilleDanceStudio.Models.FundraiserEvent ev in Model)
            {
                <div class="col-lg-6">
                    <div class="eds-event-item">
                        <div class="eds-date-pill">
                            <span class="eds-date-month">
                                @ev.EventDate.ToString("MMM").ToUpper()
                            </span>
                            <span class="eds-date-day">
                                @ev.EventDate.ToString("dd")
                            </span>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="fw-bold text-white mb-1">
                                    @ev.EventName
                                </h5>
                                <span class="badge"
                                      style="background-color: #ff10f0;">
                                    @ev.CategoryBadge
                                </span>
                            </div>
                            <p class="text-light opacity-75 small mb-1">
                                @ev.Description
                            </p>
                            <span class="small fw-semibold"
                                  style="color: #ff10f0;">
                                @ev.TimeAndLocation
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-light opacity-75 mb-0">
                    New studio fundraisers, bake sales, and showcases will
                    be posted here soon!
                </p>
            </div>
        }
    </div>
</div>