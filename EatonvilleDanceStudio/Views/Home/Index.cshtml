@await Component.InvokeAsync("WeatherWidget")
@await Component.InvokeAsync("CompetitionBanners")
@{
    ViewData["Title"] = "Home Page";
}

<!-- Summary: Animated 3-Slide Hero Carousel with Ken Burns zoom effect -->
<div id="studioHeroCarousel"
     class="carousel slide carousel-fade eds-hero-carousel mb-5"
     data-bs-ride="carousel"
     data-bs-interval="5000">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#studioHeroCarousel"
                data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#studioHeroCarousel"
                data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#studioHeroCarousel"
                data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">
        <!-- Slide 1: Main Studio Welcome -->
        <div class="carousel-item active eds-hero-slide">
            <div class="eds-hero-bg"
                 style="background-image: url('https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?auto=format&fit=crop&w=1400&q=80');">
            </div>
            <div class="eds-hero-overlay">
                <span class="eds-hero-badge">
                    Eatonville's Premier Dance Family
                </span>
                <h1 class="eds-hero-title">Eatonville Dance Studio</h1>
                <p class="lead text-light mb-4" style="max-width: 640px;">
                    Where confidence meets choreography. From tiny tot
                    first steps to national competition stages, every
                    dancer has a home here.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="DanceClasses" asp-action="Index"
                       class="btn btn-lg px-4 fw-bold text-white"
                       style="background-color: #ff10f0; border: none;">
                        Explore Classes
                    </a>
                    <a href="#community-events"
                       class="btn btn-lg btn-outline-light px-4">
                        Upcoming Fundraisers &amp; Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Slide 2: Competition & Stage Energy -->
        <div class="carousel-item eds-hero-slide">
            <div class="eds-hero-bg"
                 style="background-image: url('https://images.unsplash.com/photo-1518834107812-67b0b7c58434?auto=format&fit=crop&w=1400&q=80');">
            </div>
            <div class="eds-hero-overlay">
                <span class="eds-hero-badge">
                    2026–2027 Competition Season
                </span>
                <h2 class="eds-hero-title">Built for the Spotlight</h2>
                <p class="lead text-light mb-4" style="max-width: 640px;">
                    Watch our competitive teams shine across the Pacific
                    Northwest in Jazz, Hip-Hop, Contemporary, and Tap.
                </p>
                <a asp-controller="Competitions" asp-action="Index"
                   class="btn btn-lg px-4 fw-bold text-white"
                   style="background-color: #ff10f0; border: none;">
                    View Competition Schedule
                </a>
            </div>
        </div>

        <!-- Slide 3: Family, Grandparents & Community -->
        <div class="carousel-item eds-hero-slide">
            <div class="eds-hero-bg"
                 style="background-image: url('https://images.unsplash.com/photo-1547153760-18fc86324498?auto=format&fit=crop&w=1400&q=80');">
            </div>
            <div class="eds-hero-overlay">
                <span class="eds-hero-badge">
                    Open to Friends, Grandparents &amp; Neighbors
                </span>
                <h2 class="eds-hero-title">More Than a Studio</h2>
                <p class="lead text-light mb-4" style="max-width: 640px;">
                    No account needed to cheer on our dancers! Check out
                    our seasonal bake sales, fundraisers, and local
                    showcases below.
                </p>
                <a href="#community-events"
                   class="btn btn-lg px-4 fw-bold text-white"
                   style="background-color: #ff10f0; border: none;">
                    See Community Calendar
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Summary: Redesigned 3D Spotlight Feature Cards with Photography -->
<div class="row g-4 mb-5">
    <!-- Card 1: Dance Classes -->
    <div class="col-md-4">
        <div class="eds-spotlight-card">
            <div class="eds-card-img-wrap">
                <img src="https://images.unsplash.com/photo-1535525153412-5a42439a210d?auto=format&fit=crop&w=800&q=80"
                     alt="Youth and Adult Dance Classes" />
                <span class="eds-card-tag">Ages 3 to Adult</span>
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
                <h4 class="fw-bold mb-2" style="color: #ff10f0;">
                    Dance Classes
                </h4>
                <p class="text-light opacity-75 flex-grow-1">
                    High-energy Hip-Hop, classical Ballet, Acro, Jazz,
                    and Contemporary taught in a supportive, technique-first
                    environment.
                </p>
                <a asp-controller="DanceClasses" asp-action="Index"
                   class="btn btn-outline-primary w-100 mt-2 fw-bold">
                    Browse Class Schedule
                </a>
            </div>
        </div>
    </div>

    <!-- Card 2: Private Lessons -->
    <div class="col-md-4">
        <div class="eds-spotlight-card">
            <div class="eds-card-img-wrap">
                <img src="https://images.unsplash.com/photo-1504609773096-104ff2c73ba4?auto=format&fit=crop&w=800&q=80"
                     alt="One-on-One Private Dance Coaching" />
                <span class="eds-card-tag">1-on-1 Coaching</span>
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
                <h4 class="fw-bold mb-2" style="color: #ff10f0;">
                    Private Lessons
                </h4>
                <p class="text-light opacity-75 flex-grow-1">
                    Personalized solo choreography, audition prep, and
                    focused technique building tailored to your dancer's
                    exact goals.
                </p>
                <a asp-controller="PrivateLessons" asp-action="Index"
                   class="btn btn-outline-primary w-100 mt-2 fw-bold">
                    Book a Private Session
                </a>
            </div>
        </div>
    </div>

    <!-- Card 3: Studio Rentals -->
    <div class="col-md-4">
        <div class="eds-spotlight-card">
            <div class="eds-card-img-wrap">
                <img src="https://images.unsplash.com/photo-1574680096145-d05b474e2155?auto=format&fit=crop&w=800&q=80"
                     alt="Studio Floor Rentals and Events" />
                <span class="eds-card-tag">Sprung Floors</span>
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
                <h4 class="fw-bold mb-2" style="color: #ff10f0;">
                    Studio Rentals
                </h4>
                <p class="text-light opacity-75 flex-grow-1">
                    Reserve our professional sprung-floor studio rooms,
                    full-wall mirrors, and sound systems for rehearsals
                    or birthday parties.
                </p>
                <a asp-controller="StudioRentals" asp-action="Index"
                   class="btn btn-outline-primary w-100 mt-2 fw-bold">
                    Check Room Availability
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Summary: Public Family, Grandparent & Community Fundraiser Bulletin -->
<div id="community-events" class="eds-community-board mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge rounded-pill mb-2"
                  style="background-color: #ff10f0; color: #fff;">
                PUBLIC COMMUNITY CALENDAR • NO LOGIN REQUIRED
            </span>
            <h3 class="fw-bold text-white mb-1">
                Family Events, Bake Sales &amp; Fundraisers
            </h3>
            <p class="text-light opacity-75 mb-0">
                Grandparents, neighbors, and friends—come cheer on our
                dancers and support their road to Nationals!
            </p>
        </div>
    </div>

    <div class="row g-3">
        <!-- Event 1: Holiday Bake Sale -->
        <div class="col-lg-6">
            <div class="eds-event-item">
                <div class="eds-date-pill">
                    <span class="eds-date-month">DEC</span>
                    <span class="eds-date-day">05</span>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="fw-bold text-white mb-1">
                            Holiday Sweet Treats Bake Sale
                        </h5>
                        <span class="badge bg-success">Fundraiser</span>
                    </div>
                    <p class="text-light opacity-75 small mb-1">
                        Homemade cookies, cinnamon rolls, and hot cocoa in
                        the studio lobby. 100% of proceeds help cover
                        dancer competition entry fees!
                    </p>
                    <span class="small fw-semibold" style="color: #ff10f0;">
                        Saturday, 9:00 AM – 2:00 PM • Studio Front Lobby
                    </span>
                </div>
            </div>
        </div>

        <!-- Event 2: Winter Family Showcase -->
        <div class="col-lg-6">
            <div class="eds-event-item">
                <div class="eds-date-pill">
                    <span class="eds-date-month">DEC</span>
                    <span class="eds-date-day">19</span>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="fw-bold text-white mb-1">
                            Winter Sneak-Peek Family Showcase
                        </h5>
                        <span class="badge bg-info text-dark">
                            Grandparents Welcome
                        </span>
                    </div>
                    <p class="text-light opacity-75 small mb-1">
                        Grab a front-row seat as our recreational and
                        competition dancers debut their winter routines.
                        Admission by donation at the door.
                    </p>
                    <span class="small fw-semibold" style="color: #ff10f0;">
                        Saturday, 5:30 PM Doors Open • Eatonville High Auditorium
                    </span>
                </div>
            </div>
        </div>

        <!-- Event 3: Travel Team Raffle & Silent Auction -->
        <div class="col-lg-6">
            <div class="eds-event-item">
                <div class="eds-date-pill">
                    <span class="eds-date-month">JAN</span>
                    <span class="eds-date-day">16</span>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="fw-bold text-white mb-1">
                            Road-to-Fly-Dance Gift Basket Raffle
                        </h5>
                        <span class="badge bg-warning text-dark">
                            Team Support
                        </span>
                    </div>
                    <p class="text-light opacity-75 small mb-1">
                        Local Eatonville gift baskets, coffee bundles, and
                        50/50 raffle tickets available all week at the
                        front desk.
                    </p>
                    <span class="small fw-semibold" style="color: #ff10f0;">
                        Drawing at 4:00 PM • Winners Notified by Phone
                    </span>
                </div>
            </div>
        </div>

        <!-- Event 4: Pancake Breakfast Fundraiser -->
        <div class="col-lg-6">
            <div class="eds-event-item">
                <div class="eds-date-pill">
                    <span class="eds-date-month">FEB</span>
                    <span class="eds-date-day">06</span>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="fw-bold text-white mb-1">
                            Dancer Send-Off Pancake Breakfast
                        </h5>
                        <span class="badge bg-success">Fundraiser</span>
                    </div>
                    <p class="text-light opacity-75 small mb-1">
                        Bring the whole family for stacks of pancakes
                        served by our competition team before we head to
                        Renton for Fly Dance!
                    </p>
                    <span class="small fw-semibold" style="color: #ff10f0;">
                        Saturday, 8:00 AM – 11:30 AM • Community Center Hall
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>