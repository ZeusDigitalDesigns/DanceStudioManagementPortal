@using ServiceStack.Messaging
@model EatonvilleDanceStudio.ViewModels.ParentDashboardViewModel

@{
    ViewData["Title"] = "Family Hub";
}


<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-neon mb-0">Family Hub</h1>
        <p class="text-light mb-0">Account: 
            <span class="badge @(Model.Profile.AccountStatus == "Approved" ? "bg-success" : "bg-warning text-dark")">
                @Model.Profile.AccountStatus
            </span>
        </p>
    </div>

    <div class="row g-4">
        
        <!-- Left Column: Heavy Data (Classes and Dancers) -->
        <div class="col-lg-8">

            <!-- Account Contact Info -->
            <div class="card card-dark shadow-lg border-neon mb-4">
                <div class="card-header border-neon bg-transparent">
                    <h4 class="text-neon mb-0">Contact Profile</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Primary Contact -->
                        <div class="col-md-6 border-end border-secondary">
                            <h6 class="text-neon mb-2">Primary Contact</h6>
                            <p class="text-light mb-1"><strong>Name:</strong> @Model.Profile.FirstName @Model.Profile.LastName</p>
                            <p class="text-light mb-0"><strong>Phone:</strong> @Model.Profile.PrimaryPhone</p>
                        </div>

                        <!-- Emergency Contact -->
                        <div class="col-md-6 ps-md-4 mt-3 mt-md-0">
                            <h6 class="text-neon mb-2">Emergency Contact</h6>
                            <p class="text-light mb-1"><strong>Name:</strong> @Model.Profile.EmergencyContactName</p>
                            <p class="text-light mb-0"><strong>Phone:</strong> @Model.Profile.EmergencyContactPhone</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- NEW INTEGRATED FINANCIAL LEDGER -->
            <div class="card card-dark shadow-lg border-neon mb-4">
                <div class="card-header border-neon bg-transparent">
                    <h4 class="text-neon mb-0">Financial Ledger</h4>
                </div>
                <div class="card-body">
                    <!-- Balance and Pay Button -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
                        <div>
                            <p class="text-neon mb-1"><strong>Current Balance:</strong></p>
                            <h2 class="text-danger mb-0">@Model.CurrentBalance.ToString("C")</h2>
                        </div>
                        @if (Model.CurrentBalance > 0)
                        {
                            <form asp-controller="Payment" asp-action="Checkout" method="post">
                                <button type="submit" class="btn btn-neon btn-lg">Pay Balance Securely</button>
                            </form>
                        }
                    </div>

                    <div class="row g-3">
                        <!-- Charges Table -->
                        <div class="col-md-6">
                            <h6 class="text-neon mb-2">Recent Charges</h6>
                            <div class="table-responsive">
                                <table class="table table-dark table-sm table-hover mb-0 align-middle">
                                    <thead>
                                        <tr class="border-secondary">
                                            <th class="text-neon">Date</th>
                                            <th class="text-neon">Description</th>
                                            <th class="text-neon text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.RecentCharges.Any())
                                        {
                                            foreach (var charge in Model.RecentCharges)
                                            {
                                                <tr class="border-secondary">
                                                    <td class="text-muted small">@charge.TransactionDate.ToShortDateString()</td>
                                                    <td>@charge.Description</td>
                                                    <td class="text-end">@charge.Amount.ToString("C")</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-2">No recent charges.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Payments Table -->
                        <div class="col-md-6">
                            <h6 class="text-neon mb-2">Payment History</h6>
                            <div class="table-responsive">
                                <table class="table table-dark table-sm table-hover mb-0 align-middle">
                                    <thead>
                                        <tr class="border-secondary">
                                            <th class="text-neon">Date</th>
                                            <th class="text-neon">Description</th>
                                            <th class="text-neon text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @if (Model.RecentPayments.Any())
                                    {
                                        foreach (var payment in Model.RecentPayments)
                                        {
                                            <tr class="border-secondary">
                                                <td class="text-light small">@payment.TransactionDate.ToShortDateString()</td>
                                                <td>@payment.Description</td>
                                                <!-- Formatting payments as positive numbers for the UI -->
                                                <td class="text-end text-success">@Math.Abs(payment.Amount).ToString("C")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-light py-2">No recent payments.</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Enrolled Classes Roster -->
            <div class="card card-dark shadow-lg border-neon mb-4">
                <div class="card-header border-secondary bg-transparent d-flex justify-content-between align-items-center">
                    <h4 class="text-neon mb-0">Current Enrollments</h4>
                    @if (Model.Profile.AccountStatus == "Approved")
                    {
                        <a asp-controller="Class" asp-action="Index" class="btn btn-outline-neon btn-sm border-neon text-neon">Browse Classes</a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary btn-sm text-light border-secondary" disabled title="Pending Director Approval">Browse Classes (Locked)</button>
                    }
                </div>                
                <div class="card-body p-0">
                    @if (!Model.EnrolledClasses.Any())
                    {
                        <div class="p-4 text-center">
                            <p class="text-light mb-0">No dancers are currently enrolled in classes.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0 align-middle">
                                <thead>
                                <tr class="border-secondary">
                                    <th class="text-neon ps-4">Dancer</th>
                                    <th class="text-neon">Class</th>
                                    <th class="text-neon">Schedule</th>
                                    <th class="text-neon pe-4">Status</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var enrollment in Model.EnrolledClasses)
                                {
                                    <tr class="border-secondary">
                                        <td class="ps-4">@enrollment.Dancer?.FirstName</td>
                                        <td>
                                            @enrollment.DanceClass?.ClassName
                                            <a asp-controller="Parent" asp-action="Board" asp-route-id="@enrollment.DanceClass?.Id" 
                                               class="badge bg-neon text-neon text-decoration-none ms-2">
                                                Class Board
                                            </a>
                                        </td>
                                        <td class="text-light small">@enrollment.DanceClass?.DayOfWeek @@@enrollment.DanceClass?.StartTime.ToString(@"hh\:mm")</td>
                                        <td class="pe-4">
                                            <span class="badge @(enrollment.Status == "Enrolled" ? "bg-success" : "bg-warning text-dark")">
                                                @enrollment.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Dancer Profiles -->
            <div class="card card-dark shadow-lg border-neon">
                <div class="card-header border-secondary bg-transparent d-flex justify-content-between align-items-center">
                    <h4 class="text-neon mb-0">My Dancers</h4>
                    <a asp-action="AddDancer" class="btn btn-neon btn-sm">Add Dancer</a>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var dancer in Model.Dancers)
                        {
                            <div class="col-md-6">
                                <div class="card bg-transparent border-neon h-100">
                                    <div class="card-body d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="text-neon mb-0">@dancer.FirstName @dancer.LastName</h5>
                                            <small class="text-light">Level: @dancer.SkillLevel | Age: @dancer.Age</small>
                                            
                                            @if (!string.IsNullOrEmpty(dancer.MedicalAlerts))
                                            {
                                                <div class="mt-2">
                                                    <span class="badge bg-danger rounded-0">Medical Alert</span>
                                                </div>
                                            }
                                        </div>
                                        <a asp-action="EditDancer" asp-route-id="@dancer.Id" class="btn btn-outline-neon btn-sm">Edit</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- Right Column: Informational Feeds -->
        <div class="col-lg-4">
        
            <!-- Quick Links (Waivers & Medical Notes) -->
            <div class="card card-dark shadow-lg border-neon mb-4">
                <div class="card-header border-secondary bg-transparent">
                    <h5 class="text-neon mb-0">Quick Actions</h5>
                </div>
                <div class="list-group list-group-flush rounded-0">
                    <a href="#" class="list-group-item list-group-item-action bg-transparent text-light border-secondary">
                        <span class="text-neon me-2">📝</span> Update Medical/Allergy Notes
                    </a>
                    <a asp-controller="Parent" asp-action="SignWaiver" class="list-group-item list-group-item-action bg-transparent text-light border-secondary border-bottom-0">
                        <span class="text-neon me-2">✍️</span> Sign Digital Waivers
                    </a>
                </div>
            </div>

            <!-- Secure Messages & Blasts -->
            <div class="card card-dark shadow-lg border-neon mb-4">
                <div class="card-header border-secondary bg-transparent">
                    <h5 class="text-neon mb-0">Studio Announcements</h5>
                </div>
                <div class="list-group list-group-flush">
                    @if (Model.Messages != null && Model.Messages.Any())
                    {
                        foreach (var message in Model.Messages)
                        {
                            <div class="list-group-item bg-transparent text-light border-secondary">
                                <div class="d-flex w-100 justify-content-between mb-1">
                                    <h6 class="mb-0 text-neon fw-bold">@message.Subject</h6>
                                    <small class="text-muted">@message.SentAt.ToString("MMM dd")</small>
                                </div>
                                <p class="mb-2 small text-secondary">
                                    @if(message.Sender != null)
                                    {
                                        <span class="text-light">
                                            From: @message.Sender.FirstName @message.Sender.LastName
                                        </span><br />
                                    }
                                    @message.Body
                                </p>
                                
                                <!-- Badges and Reply Button -->
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="badge @(message.ReceiverId == null ? "bg-info text-dark" : "bg-neon text-dark") rounded-0">
                                        @(message.ReceiverId == null ? "Studio Blast" : "Direct Message")
                                    </span>
                                    
                                    @if(message.SenderId != null)
                                    {
                                        <!-- Triggers the Modal below -->
                                        <button type="button" class="btn btn-sm btn-outline-neon rounded-0" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#replyModal-@message.Id">
                                            Reply
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Individual Reply Modal for this message -->
                            <div class="modal fade" id="replyModal-@message.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content bg-dark border-neon rounded-0">
                                        <div class="modal-header border-secondary">
                                            <h5 class="modal-title text-neon">
                                                Reply to @(message.Sender?.FirstName ?? "Studio")
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" 
                                                    data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="SendMessage" method="post">
                                            <div class="modal-body">
                                                <!-- Hidden fields pass the ID and Subject back to the controller -->
                                                <input type="hidden" name="receiverId" value="@message.SenderId" />
                                                <input type="hidden" name="subject" value="@message.Subject" />
                                                
                                                <div class="mb-3">
                                                    <label class="form-label text-light">Message</label>
                                                    <textarea name="body" 
                                                              class="form-control bg-black text-light border-secondary rounded-0" 
                                                              rows="4" required 
                                                              placeholder="Type your reply here..."></textarea>
                                                </div>
                                                <div class="text-muted small">
                                                    Replying to: "@message.Subject"
                                                </div>
                                            </div>
                                            <div class="modal-footer border-secondary">
                                                <button type="button" class="btn btn-outline-secondary rounded-0" 
                                                        data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-neon rounded-0">
                                                    Send Reply
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="list-group-item bg-transparent text-muted border-secondary text-center py-3">
                            No recent messages or announcements.
                        </div>
                    }
                </div>
            </div>

            <!-- Upcoming Events -->
            <div class="card card-dark shadow-lg border-neon mb-4">
                <div class="card-header border-secondary bg-transparent">
                    <h5 class="text-neon mb-0">Upcoming Events</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <li class="list-group-item bg-transparent text-light border-secondary">
                            <span class="text-neon me-2">🗓️</span> @ev
                        </li>
                    }
                </ul>
            </div>

            <!-- Competition History -->
            <div class="card card-dark shadow-lg border-neon">
                <div class="card-header border-secondary bg-transparent">
                    <h5 class="text-neon mb-0">Trophy Case</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var placement in Model.CompetitionPlacements)
                    {
                        <li class="list-group-item bg-transparent text-light border-secondary">
                            <span class="text-warning me-2">🏆</span> @placement
                        </li>
                    }
                </ul>
            </div>

        </div>
    </div>
</div>