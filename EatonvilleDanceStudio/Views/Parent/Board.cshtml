@model EatonvilleDanceStudio.ViewModels.ParentClassBoardViewModel

@{
    ViewData["Title"] = Model.DanceClass.ClassName + " - Board";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-neon mb-0">@Model.DanceClass.ClassName Board</h1>
            <p class="text-light mb-0">
                Latest announcements from the instructor
            </p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-light">
            Back to Dashboard
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card card-dark shadow-lg border-secondary">
                <div class="card-header border-secondary bg-transparent">
                    <h5 class="text-light mb-0">Class Feed</h5>
                </div>
                <div class="card-body">
                    @if (Model.Announcements.Count == 0)
                    {
                        <div class="p-4 text-center">
                            <p class="text-muted mb-0">
                                No announcements have been posted yet.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (ClassAnnouncement post in Model.Announcements)
                            {
                                <div class="p-3 border border-secondary rounded">
                                    <div class="d-flex justify-content-between">
                                        <h5 class="text-neon mb-1">
                                            @post.Title
                                        </h5>
                                        <small class="text-muted">
                                            @post.DatePosted.ToShortDateString()
                                        </small>
                                    </div>
                                    <p class="text-light mb-0 mt-2">
                                        @post.Message
                                    </p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>