@model EatonvilleDanceStudio.ViewModels.AccountManageViewModel

@{
    ViewData["Title"] = "Manage Account";
}

<div class="container mt-4">
    <h1 class="text-neon mb-0">Manage your account</h1>
    <p class="text-light mb-4">Change your account settings</p>
    <hr class="border-neon border-2 opacity-100" />

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success rounded-0 bg-black text-neon border-secondary mb-4" role="alert">
            @TempData["StatusMessage"]
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-md-3">
            <div class="list-group rounded-0">
                <a class="list-group-item list-group-item-action bg-black text-neon border-neon active" asp-controller="Account" asp-action="Manage">Profile</a>
            </div>
        </div>
        <!-- Main Form Area -->
        <div class="col-md-9">
            <div class="card card-dark rounded-0 border-neon shadow-lg">
                <div class="card-body p-4 text-light">
                    <form method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Username" class="form-control bg-black text-light border-neon rounded-0 shadow-none">
                            <label asp-for="Username" class="text-muted">Username</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control bg-black text-light border-neon rounded-0 shadow-none">
                            <label asp-for="Email" class="text-muted">Email</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="PhoneNumber" class="form-control bg-black text-light border-neon rounded-0 shadow-none" placeholder="Enter phone number" />
                            <label asp-for="PhoneNumber" class="text-muted">Phone Number </label>
                        </div>
                        <button type="submit" class="btn btn-neon rounded-0 w-100 btn-lg mt-2">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>