@using EatonvilleDanceStudio.Models
@model EatonvilleDanceStudio.ViewModels.InstructorDashboardViewModel
@{
    ViewData["Title"] = "Instructor Dashboard";
}

<div class="container mt-4">
    <!-- Dashboard Header: Flat text, no weird text-shadows -->
    <h1 class="text-primary fw-bold" style="text-shadow: none;">
        Welcome, @Model.Instructor.FirstName
    </h1>
    <hr class="border-primary border-2 opacity-100" />
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-0 border-0">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-0 border-0">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- ROW 1: Today's Schedule & Log Hours -->
    <div class="row mb-4">
        <!-- Left Column: Today's Schedule -->
        <div class="col-md-7">
            <div class="card card-dark rounded-0 h-100">
                <div class="card-header border-bottom border-primary">
                    <h5 class="mb-0 text-primary">Today's Classes</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @if (Model.TodaysSchedule.Count == 0)
                    {
                        <li class="list-group-item bg-transparent text-muted border-0">
                            No classes scheduled for today. Kick back.
                        </li>
                    }
                    else
                    {
                        @foreach (DanceClass c in Model.TodaysSchedule)
                        {
                            <li class="list-group-item bg-transparent text-light 
                                       border-secondary d-flex 
                                       justify-content-between align-items-center">
                                <div>
                                    <strong>@c.ClassName</strong><br />
                                    <small class="text-secondary">
                                        @c.StartTime.ToString("t") - 
                                        @c.EndTime.ToString("t")
                                    </small>
                                </div>
                                <div class="d-flex gap-2">
                                    <!-- Flat secondary button for the Board -->
                                    <a asp-controller="Instructor" asp-action="Board" asp-route-id="@c.Id" 
                                       class="btn btn-sm btn-outline-neon rounded-0">
                                        Messages
                                    </a>
    
                                    <!-- Existing neon button for the Roster -->
                                    <a asp-action="Roster" asp-route-id="@c.Id" 
                                       class="btn btn-sm btn-outline-neon rounded-0">
                                        View Roster
                                    </a>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>

        <!-- Right Column: Log Hours Form -->
        <div class="col-md-5">
            <div class="card card-dark rounded-0 h-100">
                <div class="card-header border-bottom border-primary">
                    <h5 class="mb-0 text-primary">Log Hours</h5>
                </div>
                <div class="card-body">
                    <form asp-action="LogHours" method="post">
                        <div class="mb-3">
                            <label class="form-label text-secondary">Date</label>
                            <input asp-for="NewLog.Date" type="date" 
                                   class="form-control bg-secondary text-light 
                                          border-0 rounded-0" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary">
                                Hours Worked
                            </label>
                            <input asp-for="NewLog.Hours" type="number" 
                                   step="0.5" class="form-control bg-secondary 
                                          text-light border-0 rounded-0" required />
                        </div>
                        <!-- Replaced outline-primary with outline-neon -->
                        <button type="submit" 
                                class="btn btn-outline-neon w-100 rounded-0 mt-3">
                            Submit for Approval
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ROW 2: Upcoming Schedule & Recent Logs -->
    <div class="row">
        <!-- Left Column: Upcoming Classes -->
        <div class="col-md-7">
            <div class="card card-dark rounded-0 mb-4">
                <div class="card-header border-bottom border-primary">
                    <h5 class="mb-0 text-primary">Upcoming Classes</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @if (Model.UpcomingSchedule.Count == 0)
                    {
                        <li class="list-group-item bg-transparent text-muted border-0">
                            No upcoming classes found.
                        </li>
                    }
                    else
                    {
                        @foreach (DanceClass c in Model.UpcomingSchedule)
                        {
                            <li class="list-group-item bg-transparent text-light 
                                       border-secondary">
                                <strong>@c.ClassName</strong> 
                                <span class="text-secondary ms-2">
                                    (@c.DayOfWeek, @c.StartTime.ToString("t"))
                                </span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>

        <!-- Right Column: Recent Time Logs -->
        <div class="col-md-5">
            <div class="card card-dark rounded-0 mb-4">
                <div class="card-header border-bottom border-primary">
                    <h5 class="mb-0 text-primary">Recent Time Logs</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Hours</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentTimeLogs.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-muted border-0">
                                        No recent logs.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (InstructorTimeLog log in Model.RecentTimeLogs)
                                {
                                    <tr>
                                        <td>@log.Date.ToString("MM/dd")</td>
                                        <td>@log.Hours</td>
                                        <td>
                                            @if (log.IsApproved)
                                            {
                                                <span class="text-success">Approved</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>