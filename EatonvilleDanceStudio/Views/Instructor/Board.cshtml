@model EatonvilleDanceStudio.ViewModels.ClassBoardViewModel
@{
    ViewData["Title"] = Model.DanceClass.ClassName + " - Board";
}

<div class="container mt-4">
    <!-- Header with Dashboard button and Post Update button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-neon mb-0" style="text-shadow: none;">@Model.DanceClass.ClassName Board</h1>
            <p class="text-light mb-0">Message board for enrolled students</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Instructor" asp-action="Dashboard" 
               class="btn btn-outline-secondary rounded-0">
                ← Dashboard
            </a>
        </div>
    </div>
    <hr class="border-neon border-2 opacity-100" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-0 border-0">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">
        <!-- Post a New Message Form -->
        <div class="col-md-5">
            <div class="card card-dark rounded-0 border-neon h-100">
                <div class="card-header border-bottom border-neon bg-transparent">
                    <h5 class="text-neon mb-0">Post an Update</h5>
                </div>
                <div class="card-body">
                    <form asp-action="PostAnnouncement" method="post">
                        <input type="hidden" asp-for="NewAnnouncement.DanceClassId" value="@Model.DanceClass.Id" />

                        <div class="mb-3">
                            <label asp-for="NewAnnouncement.Title" class="form-label text-secondary">Title</label>
                            <input asp-for="NewAnnouncement.Title" 
                                   class="form-control bg-dark text-light border-secondary rounded-0" 
                                   placeholder="e.g. Bring Recital Shoes!" required />
                        </div>
                        <div class="mb-4">
                            <label asp-for="NewAnnouncement.Message" class="form-label text-secondary">Message / Links</label>
                            <textarea asp-for="NewAnnouncement.Message" 
                                      class="form-control bg-dark text-light border-secondary rounded-0" 
                                      rows="4" placeholder="Drop your notes or links here..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-neon w-100 rounded-0">
                            Post to Board
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Announcement Feed Table / List Container -->
        <div class="col-md-7">
            <div class="card card-dark rounded-0 border-neon h-100">
                <div class="card-header border-bottom border-neon bg-transparent">
                    <h5 class="text-neon mb-0">Recent Announcements</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Announcements == null || !Model.Announcements.Any())
                    {
                        <div class="p-4 text-center">
                            <p class="text-muted mb-0">You haven't posted any announcements yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0 align-middle">
                                <thead>
                                    <tr class="border-neon">
                                        <th class="text-neon ps-4">TITLE</th>
                                        <th class="text-neon">MESSAGE</th>
                                        <th class="text-neon pe-4 text-end">DATE</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var post in Model.Announcements)
                                    {
                                        <tr class="border-secondary">
                                            <td class="ps-4 fw-bold text-light">
                                                @post.Title
                                            </td>
                                            <td class="text-secondary text-break" style="max-width: 350px;">
                                                @post.Message
                                            </td>
                                            <td class="pe-4 text-end text-muted">
                                                @post.DatePosted.ToString("MMM dd, yyyy")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>