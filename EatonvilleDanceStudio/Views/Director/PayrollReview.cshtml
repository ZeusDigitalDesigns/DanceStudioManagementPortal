@model EatonvilleDanceStudio.ViewModels.PayrollReviewViewModel

@{
    ViewData["Title"] = "Payroll Review";
}

<div class="container mt-4">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="text-neon mb-0">Payroll Review</h2>
        </div>
        <div class="col-auto">
            <a asp-action="ManageUsers" class="btn btn-outline-secondary">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>
    
    <hr class="border-neon mb-4" />

    <div class="row mb-4">
        <!-- Date Filter Form -->
        <div class="col-md-8 mb-3 mb-md-0">
            <div class="card card-dark h-100">
                <div class="card-body">
                    <form asp-action="PayrollReview" method="get" class="row align-items-end">
                        <div class="col-md-5 mb-3 mb-md-0">
                            <label asp-for="StartDate" class="form-label text-muted">Start Date</label>
                            <input asp-for="StartDate" class="form-control form-control-dark" />
                        </div>
                        <div class="col-md-5 mb-3 mb-md-0">
                            <label asp-for="EndDate" class="form-label text-muted">End Date</label>
                            <input asp-for="EndDate" class="form-control form-control-dark" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-neon w-100">Filter</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Dynamic Total Hours Widget -->
        <div class="col-md-4">
            <div class="card card-dark border-neon h-100">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h6 class="text-muted text-uppercase mb-2">Total Hours in Range</h6>
                    <!-- Formatting as 0.00 so 14.5 shows as 14.50 -->
                    <h2 class="text-success mb-0">@Model.TotalHours.ToString("0.00")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Time Logs Table -->
    <div class="card card-dark">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-neon">Instructor Time Logs</h4>
            <a asp-controller="Director" asp-action="ExportPayrollCsv" 
               asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
               asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
               class="btn btn-sm btn-outline-success">
                Export CSV
            </a>
        </div>
        <div class="card-body">
            @if (Model.TimeLogs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Instructor</th>
                                <th>Hours</th>
                                <th>Notes</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.TimeLogs)
                            {
                                <tr style="border-bottom: 1px solid #444;">
                                    <td>@log.Date.ToShortDateString()</td>
                                    <td>
                                        @(log.Instructor != null ? $"{log.Instructor.FirstName} {log.Instructor.LastName}" : "Unknown")
                                    </td>
                                    <td><strong>@log.Hours.ToString("0.00")</strong></td>
                                    <td class="text-muted small">@log.Description</td>
                                    <td>
                                        <span class="badge @(log.IsApproved ? "bg-success" : "bg-warning text-dark")">
                                            @(log.IsApproved ? "Approved" : "Pending")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No time logs found for this date range.</p>
            }
        </div>
    </div>
</div>