@model IEnumerable<EatonvilleDanceStudio.Models.CostumeOrder>

@{
    ViewData["Title"] = "Costume Management";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 border border-neon rounded" style="background-color: #121212;">
        <div>
            <h2 class="text-neon mb-0">Costume Order Tracking</h2>
            <small class="text-neon">Manage sizing, payments, and delivery lifecycles.</small>
        </div>
        <div>
            <a asp-action="CreateCostumeOrder" class="btn btn-neon btn-sm">+ New Costume Order</a>
        </div>
    </div>

    <div class="row">
        <!-- Left Side: Order Tracking Table -->
        <div class="col-md-9 mb-4">
            <div class="table-responsive">
                <table class="table table-dark table-hover border-secondary align-middle">
                    <thead>
                        <tr class="text-neon">
                            <th>Dancer</th>
                            <th>Class</th>
                            <th>Costume</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th>Expected</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>@order.Dancer?.FirstName @order.Dancer?.LastName</td>
                                    <td>@order.DanceClass?.ClassName</td>
                                    <td>
                                        @order.CostumeName
                                        @if (!string.IsNullOrEmpty(order.VendorLink))
                                        {
                                            <a href="@order.VendorLink" target="_blank" class="ms-1 text-info"><i class="bi bi-box-arrow-up-right"></i></a>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(order.PaymentStatus == "Paid" ? "bg-success" : "bg-danger") text-dark rounded-pill">
                                            @order.PaymentStatus
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary text-light rounded-pill">
                                            @order.OrderStatus
                                        </span>
                                    </td>
                                    <td>@(order.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "TBD")</td>
                                    <td>
                                        <a asp-action="EditCostumeOrder" asp-route-id="@order.Id" class="btn btn-outline-neon btn-sm">Update</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-light py-4">No costume orders found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right Side: Vendor Links -->
        <div class="col-md-3 mb-4">
            <div class="card bg-dark border-neon shadow-sm">
                <div class="card-header border-secondary bg-transparent">
                    <h6 class="text-neon mb-0">Preferred Vendors</h6>
                </div>
                <div class="list-group list-group-flush">
                    <a href="https://www.weissmans.com" target="_blank" class="list-group-item bg-transparent text-light border-secondary">Weissman Costumes</a>
                    <a href="https://www.revolutiondance.com" target="_blank" class="list-group-item bg-transparent text-light border-secondary">Revolution Dancewear</a>
                    <a href="https://www.discountdance.com" target="_blank" class="list-group-item bg-transparent text-light border-secondary">Discount Dance Supply</a>
                    <a href="https://www.kellecompany.com" target="_blank" class="list-group-item bg-transparent text-light border-secondary">Kelle Company</a>
                </div>
            </div>
        </div>
    </div>
</div>