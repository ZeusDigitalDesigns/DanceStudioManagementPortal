@model EatonvilleDanceStudio.ViewModels.CreateInvoiceViewModel

@{
    ViewData["Title"] = "Create Manual Invoice";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            
            <!-- Using the card-dark class to match our admin theme -->
            
            <div class="card card-dark mb-4">
                <div class="card-header">
                    <h4 class="mb-0 text-neon">Create Manual Invoice</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateInvoice" method="post">
                        
                        <!-- Validation summary for overall form errors -->
                        
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <!-- Bill To (User Dropdown) -->
                        
                        <div class="form-group mb-3">
                            <label asp-for="UserId" class="form-label"></label>
                            <select asp-for="UserId"
                                    asp-items="Model.UsersList"
                                    class="form-select form-control-dark">
                                <option value="">-- Select a User --</option>
                            </select>
                            <span asp-validation-for="UserId"
                                  class="text-danger"></span>
                        </div>

                        <!-- Description -->
                        
                        <div class="form-group mb-3">
                            <label asp-for="Description"
                                   class="form-label"></label>
                            <input asp-for="Description"
                                   class="form-control form-control-dark"
                                   placeholder="e.g. Late Fee, Private Lesson"/>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <!-- Amount -->
                        
                        <div class="form-group mb-3">
                            <label asp-for="Amount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-light border-secondary">
                                    $
                                </span>
                                <input asp-for="Amount"
                                       type="number"
                                       step="0.01"
                                       class="form-control form-control-dark"/>
                            </div>
                            <span asp-validation-for="Amount"
                                  class="text-danger"></span>
                        </div>

                        <!-- Due Date -->
                        
                        <div class="form-group mb-4">
                            <label asp-for="DueDate" class="form-label"></label>
                            <input asp-for="DueDate"
                                   type="date"
                                   class="form-control form-control-dark"/>
                            <span asp-validation-for="DueDate"
                                  class="text-danger"></span>
                        </div>

                        <!-- Form Actions -->
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="ManageUsers"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-neon">
                                Generate Invoice
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Injects client-side validation to catch errors before hitting the server -->
    <partial name="_ValidationScriptsPartial" />
}