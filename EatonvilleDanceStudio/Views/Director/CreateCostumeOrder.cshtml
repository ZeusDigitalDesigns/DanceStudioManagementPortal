@model EatonvilleDanceStudio.Models.CostumeOrder

@{
    ViewData["Title"] = "New Costume Order";
}

<div class="container mt-4 mb-5" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 border border-neon rounded" style="background-color: #121212;">
        <h2 class="text-neon mb-0">Create Costume Order</h2>
        <a asp-action="CostumeManagement" class="btn btn-outline-secondary btn-sm">Cancel</a>
    </div>

    <div class="card bg-dark border-neon shadow-lg">
        <div class="card-body p-4">
            <form asp-action="CreateCostumeOrder" method="post">
                
                <!-- Core Linkages -->
                <h5 class="text-neon mb-3 border-bottom border-secondary pb-2">Student & Class Assignment</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="DancerId" class="form-label text-light">Select Dancer</label>
                        <select asp-for="DancerId" asp-items="ViewBag.Dancers" class="form-select bg-dark text-light border-secondary">
                            <option value="">-- Choose Dancer --</option>
                        </select>
                        <span asp-validation-for="DancerId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DanceClassId" class="form-label text-light">Select Class</label>
                        <select asp-for="DanceClassId" asp-items="ViewBag.Classes" class="form-select bg-dark text-light border-secondary">
                            <option value="">-- Choose Class --</option>
                        </select>
                        <span asp-validation-for="DanceClassId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Costume Details -->
                <h5 class="text-neon mb-3 border-bottom border-secondary pb-2">Costume Details</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label asp-for="CostumeName" class="form-label text-light"></label>
                        <input asp-for="CostumeName" class="form-control bg-dark text-light border-secondary" placeholder="e.g. Sequin Jazz Leotard" />
                        <span asp-validation-for="CostumeName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label text-light"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark text-light border-secondary">$</span>
                            <input asp-for="Price" type="number" step="0.01" class="form-control bg-dark text-light border-secondary" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="VendorLink" class="form-label text-light"></label>
                        <input asp-for="VendorLink" class="form-control bg-dark text-light border-secondary" placeholder="https://www.weissmans.com/..." />
                        <span asp-validation-for="VendorLink" class="text-danger"></span>
                    </div>
                </div>

                <!-- Lifecycle Tracking -->
                <h5 class="text-neon mb-3 border-bottom border-secondary pb-2">Order Lifecycle</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="PaymentStatus" class="form-label text-light"></label>
                        <select asp-for="PaymentStatus" class="form-select bg-dark text-light border-secondary">
                            <option value="Unpaid">Unpaid</option>
                            <option value="Paid">Paid</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OrderStatus" class="form-label text-light"></label>
                        <select asp-for="OrderStatus" class="form-select bg-dark text-light border-secondary">
                            <option value="Not Ordered">Not Ordered</option>
                            <option value="Ordered">Ordered</option>
                            <option value="Shipped">Shipped</option>
                            <option value="Received at Studio">Received at Studio</option>
                            <option value="Handed Out">Handed Out</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ExpectedDeliveryDate" class="form-label text-light"></label>
                        <input asp-for="ExpectedDeliveryDate" type="date" class="form-control bg-dark text-light border-secondary" />
                    </div>
                </div>

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-neon px-5">Submit Order</button>
                </div>
            </form>
        </div>
    </div>
</div>