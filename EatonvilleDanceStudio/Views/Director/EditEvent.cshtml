@model EatonvilleDanceStudio.ViewModels.EditStudioEventViewModel

@{
    ViewData["Title"] = "Edit Studio Event";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card card-dark mb-4">
                <div class="card-header">
                    <h4 class="mb-0 text-neon">Edit Studio Event</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EditEvent" method="post">
                        <!-- CRITICAL: Hidden ID field so the post method works -->
                        <input type="hidden" asp-for="Id" />
                        
                        <div asp-validation-summary="ModelOnly" 
                             class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Title" class="form-label"></label>
                                <input asp-for="Title" 
                                       class="form-control form-control-dark" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-4 mb-3">
                                <label asp-for="EventType" class="form-label"></label>
                                <select asp-for="EventType" 
                                        asp-items="Model.EventTypesList" 
                                        class="form-select form-control-dark"></select>
                                <span asp-validation-for="EventType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" 
                                      class="form-control form-control-dark" 
                                      rows="2"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartTime" class="form-label"></label>
                                <input asp-for="StartTime" 
                                       class="form-control form-control-dark" />
                                <span asp-validation-for="StartTime" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndTime" class="form-label"></label>
                                <input asp-for="EndTime" 
                                       class="form-control form-control-dark" />
                                <span asp-validation-for="EndTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Room" class="form-label"></label>
                                <select asp-for="Room" 
                                        asp-items="Model.RoomsList" 
                                        class="form-select form-control-dark"></select>
                                <span asp-validation-for="Room" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-4 mb-3">
                                <label asp-for="Capacity" class="form-label"></label>
                                <input asp-for="Capacity" 
                                       class="form-control form-control-dark" />
                                <span asp-validation-for="Capacity" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-4 mb-4">
                                <label asp-for="InstructorId" class="form-label"></label>
                                <select asp-for="InstructorId" 
                                        asp-items="Model.InstructorsList" 
                                        class="form-select form-control-dark">
                                    <option value="">-- Unassigned --</option>
                                </select>
                                <span asp-validation-for="InstructorId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="ManageUsers" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-neon">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}