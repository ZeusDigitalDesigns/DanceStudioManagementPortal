@*
    Summary: Renders the live Eatonville, WA weather widget for
    the public landing page and authenticated user dashboards.
*@
@model EatonvilleDanceStudio.ViewModels.WeatherViewModel

<div class="card card-dark border-neon shadow-sm mb-4">
    <div class="card-body py-2 px-3 d-flex justify-content-between
                align-items-center flex-wrap">
        <div class="d-flex align-items-center">
            <span class="fs-3 me-3">@Model.IconEmoji</span>
            <div>
                <h6 class="text-neon mb-0 fw-bold">
                    @Model.LocationName Studio Weather
                </h6>
                @if (Model.IsLoaded)
                {
                    <small class="text-light">
                        @Model.ConditionText |
                        Wind: @Model.WindSpeedMph mph
                    </small>
                }
                else
                {
                    <small class="text-muted">
                        Live weather feed temporarily unavailable
                    </small>
                }
            </div>
        </div>

        @if (Model.IsLoaded)
        {
            <div class="text-end">
                <span class="fs-4 fw-bold text-neon">
                    @(Model.TemperatureF)&deg;F
                </span>
                @if (Model.IsSevereWeather)
                {
                    <div>
                        <span class="badge bg-danger rounded-0">
                            Check Closure Alerts
                        </span>
                    </div>
                }
            </div>
        }
    </div>
</div>