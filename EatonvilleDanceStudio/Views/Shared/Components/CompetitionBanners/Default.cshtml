@model IEnumerable<EatonvilleDanceStudio.Models.Competition>

@if (Model != null && Model.Any())
{
    <!-- Summary: Dynamic Competition Banner Carousel linking each banner
         to its official RegistrationUrl alongside call times and dates. -->
    <div id="competitionBannerCarousel"
         class="carousel slide mb-4"
         data-bs-ride="carousel"
         data-bs-interval="6000">

        <div class="carousel-inner">
            @{
                bool isFirst = true;
            }
            @foreach (EatonvilleDanceStudio.Models.Competition comp in Model)
            {
                string activeClass = isFirst ? "active" : "";
                isFirst = false;

                string borderHex =
                    string.IsNullOrWhiteSpace(comp.BrandColorHex)
                        ? "#ff10f0"
                        : comp.BrandColorHex;

                <div class="carousel-item @activeClass">
                    <div class="card bg-dark text-white"
                         style="border: 2px solid @borderHex;
                                border-radius: 12px;
                                overflow: hidden;">

                        <!-- Top Banner Image (Clickable to Competition Site) -->
                        <div class="position-relative text-center p-3"
                             style="background: radial-gradient(
                                 circle,
                                 rgba(255,16,240,0.12) 0%,
                                 rgba(10,10,14,0.95) 85%);">

                            <span class="badge position-absolute top-0 start-0 m-3"
                                  style="background-color: @borderHex;
                                         color: #fff;
                                         font-weight: 700;">
                                UPCOMING @(comp.EventFormat?.ToUpper() ?? "COMPETITION")
                            </span>

                            @if (!string.IsNullOrWhiteSpace(comp.RegistrationUrl))
                            {
                                <a href="@comp.RegistrationUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   title="Visit official @comp.Name website"
                                   class="d-inline-block eds-comp-banner-link">
                                    @if (!string.IsNullOrWhiteSpace(comp.LogoUrl))
                                    {
                                        <img src="@comp.LogoUrl"
                                             alt="@comp.Name"
                                             class="img-fluid rounded"
                                             style="max-height: 210px;
                                                    object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <h2 class="fw-bold my-4"
                                            style="color: @borderHex;">
                                            @comp.Name &#8599;
                                        </h2>
                                    }
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Competitions"
                                   asp-action="Details"
                                   asp-route-id="@comp.Id"
                                   class="d-inline-block eds-comp-banner-link">
                                    @if (!string.IsNullOrWhiteSpace(comp.LogoUrl))
                                    {
                                        <img src="@comp.LogoUrl"
                                             alt="@comp.Name"
                                             class="img-fluid rounded"
                                             style="max-height: 210px;
                                                    object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <h2 class="fw-bold my-4"
                                            style="color: @borderHex;">
                                            @comp.Name
                                        </h2>
                                    }
                                </a>
                            }
                        </div>

                        <!-- Bottom Info Bar: Dates, VenueName, Fees & Call Times -->
                        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2"
                             style="background-color: #0d0d12;
                                    border-top: 1px solid @borderHex;">
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <span class="fw-bold"
                                      style="color: @borderHex;
                                             font-size: 1.1rem;">
                                    @comp.Name
                                </span>

                                <span class="small text-light">
                                    <strong>Dates:</strong>
                                    @comp.StartDate.ToString("MMM d, yyyy")
                                    @if (comp.EndDate.HasValue)
                                    {
                                        <text>
                                            - @comp.EndDate.Value.ToString("MMM d, yyyy")
                                        </text>
                                    }
                                </span>

                                @if (!string.IsNullOrWhiteSpace(comp.VenueName))
                                {
                                    <span class="small text-light">
                                        <strong>Location:</strong> @comp.VenueName
                                    </span>
                                }

                                @if (comp.FeeDueDate.HasValue)
                                {
                                    <span class="badge border border-warning text-warning bg-transparent">
                                        Fees Due:
                                        @comp.FeeDueDate.Value.ToString("MMM d, yyyy")
                                    </span>
                                }
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(comp.RegistrationUrl))
                                {
                                    <a href="@comp.RegistrationUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-sm btn-outline-light">
                                        Official Site &#8599;
                                    </a>
                                }
                                <a asp-controller="Competitions"
                                   asp-action="Details"
                                   asp-route-id="@comp.Id"
                                   class="btn btn-sm text-white fw-bold"
                                   style="background-color: @borderHex;">
                                    View Call Times
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.Count() > 1)
        {
            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#competitionBannerCarousel"
                    data-bs-slide="prev"
                    style="width: 4%;">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#competitionBannerCarousel"
                    data-bs-slide="next"
                    style="width: 4%;">
                <span class="carousel-control-next-icon"></span>
            </button>
        }
    </div>
}