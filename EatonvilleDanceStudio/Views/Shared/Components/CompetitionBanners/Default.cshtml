@*
    Summary: Renders a full-width graphic banner slideshow with
    competition fee due dates (2 weeks prior) and a direct payment
    button in the bottom bar.
*@
@using System.Globalization
@using EatonvilleDanceStudio.Models
@model List<Competition>

@if (Model != null && Model.Any())
{
    <div id="competitionBannerCarousel"
         class="carousel slide mb-4"
         data-bs-ride="carousel"
         data-bs-interval="5000">

        @if (Model.Count > 1)
        {
            <div class="carousel-indicators"
                 style="margin-bottom: 0.25rem;">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#competitionBannerCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-current="@(i == 0 ? "true" : "false")"
                            aria-label="Slide @(i + 1)">
                    </button>
                }
            </div>
        }

        <div class="carousel-inner">
            @for (int i = 0; i < Model.Count; i++)
            {
                Competition banner = Model[i];

                string brandHex =
                    string.IsNullOrWhiteSpace(banner.BrandColorHex)
                        ? "#ff10f0"
                        : banner.BrandColorHex;

                string upperFormat =
                    banner.EventFormat.ToUpperInvariant();

                string startText =
                    banner.StartDate.ToString("MMM d, yyyy");

                string dateRangeText = banner.EndDate.HasValue
                    ? $"{startText} - {banner.EndDate.Value:MMM d, yyyy}"
                    : startText;

                string venueText =
                    string.IsNullOrWhiteSpace(banner.VenueName)
                        ? "Location TBD"
                        : banner.VenueName;

                DateTime effectiveDueDate =
                    banner.FeeDueDate ?? banner.StartDate.AddDays(-14);

                string dueDateText =
                    effectiveDueDate.ToString("MMM d, yyyy");

                string feeText = banner.RegistrationFee > 0
                    ? banner.RegistrationFee.ToString(
                        "C",
                        CultureInfo.InvariantCulture)
                    : "";

                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="card card-dark overflow-hidden"
                         style="border: 2px solid @brandHex !important;
                                box-shadow: 0 0 18px @(brandHex)40;">

                        @* TOP SECTION: Majority Image Banner *@
                        @if (!string.IsNullOrWhiteSpace(
                            banner.LogoUrl))
                        {
                            <div class="position-relative w-100 overflow-hidden
            d-flex justify-content-center align-items-center p-3"
                                 style="height: 220px; background-color: #08080a;">

                                @* Blurred full-width background fill *@
                                <img src="@Url.Content(banner.LogoUrl)"
                                     aria-hidden="true"
                                     class="position-absolute top-0 start-0 w-100 h-100"
                                     style="object-fit: cover;
                                     filter: blur(18px) brightness(0.35);
                                     transform: scale(1.1);" />

                                @* Crisp proportional foreground graphic *@
                                <img src="@Url.Content(banner.LogoUrl)"
                                     alt="@banner.Name Banner"
                                     class="position-relative rounded shadow"
                                     style="max-height: 185px;
                                     max-width: 90%;
                                     object-fit: cover;
                                     z-index: 1;" />

                                <span class="badge text-dark fw-bold
                                             position-absolute top-0
                                             start-0 m-3 shadow"
                                      style="background-color: @brandHex; z-index: 2;">
                                    UPCOMING @upperFormat
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center"
                                 style="background-color: #0d0d11;">
                                <span class="badge text-dark fw-bold
                                             mb-2"
                                      style="background-color:
                                             @brandHex;">
                                    UPCOMING @upperFormat
                                </span>
                                <h2 class="fw-bold mb-0"
                                    style="color: @brandHex;">
                                    @banner.Name
                                </h2>
                            </div>
                        }

                        @* BOTTOM BAR: Date, Location, Fees & Actions *@
                        <div class="card-footer bg-black
                                    d-flex flex-column flex-md-row
                                    justify-content-between
                                    align-items-md-center gap-2
                                    px-4 py-3"
                             style="border-top: 2px solid @brandHex;">

                            <div class="d-flex flex-wrap
                                        align-items-center gap-3">
                                <h5 class="mb-0 fw-bold"
                                    style="color: @brandHex;">
                                    @banner.Name
                                </h5>

                                <span class="text-light small
                                             fw-semibold">
                                    <strong>Dates:</strong>
                                    @dateRangeText
                                </span>

                                <span class="text-light small">
                                    <strong>Location:</strong>
                                    @venueText
                                </span>

                                <span class="badge border border-warning
                                             text-warning small">
                                    @if (banner.RegistrationFee > 0)
                                    {
                                        <text>
                                            Fee: @feeText (Due @dueDateText)
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            Fees Due: @dueDateText
                                        </text>
                                    }
                                </span>
                            </div>

                            <div class="d-flex flex-wrap
                                        align-items-center gap-2">
                                @if (User.Identity != null
                                     && User.Identity.IsAuthenticated)
                                {
                                    <form asp-controller="Payment"
                                          asp-action="Checkout"
                                          method="post"
                                          class="d-inline">
                                        <input type="hidden"
                                               name="competitionId"
                                               value="@banner.Id" />
                                        <input type="hidden"
                                               name="amount"
                                               value="@banner.RegistrationFee" />
                                        <input type="hidden"
                                               name="description"
                                               value="@banner.Name Comp Fee" />
                                        <button type="submit"
                                                class="btn btn-sm fw-bold
                                                       btn-success">
                                            Pay Comp Fee
                                            @(banner.RegistrationFee > 0
                                                ? $"({feeText})"
                                                : "")
                                        </button>
                                    </form>
                                }

                                <a asp-controller="Competitions"
                                   asp-action="Details"
                                   asp-route-id="@banner.Id"
                                   class="btn btn-sm fw-bold text-dark"
                                   style="background-color: @brandHex;
                                          border-color: @brandHex;">
                                    View Call Times
                                </a>

                                @if (!string.IsNullOrWhiteSpace(
                                    banner.RegistrationUrl))
                                {
                                    <a href="@banner.RegistrationUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-outline-light
                                              btn-sm">
                                        Event Info &nearr;
                                    </a>
                                }

                                @if (User.IsInRole("Director")
                                    || User.IsInRole("Instructor"))
                                {
                                    <a asp-controller="Competitions"
                                       asp-action="Edit"
                                       asp-route-id="@banner.Id"
                                       class="btn btn-outline-neon
                                              btn-sm">
                                        Edit Banner
                                    </a>
                                }
                            </div>

                        </div>

                    </div>
                </div>
            }
        </div>

        @if (Model.Count > 1)
        {
            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#competitionBannerCarousel"
                    data-bs-slide="prev"
                    style="width: 3%;">
                <span class="carousel-control-prev-icon"
                      aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#competitionBannerCarousel"
                    data-bs-slide="next"
                    style="width: 3%;">
                <span class="carousel-control-next-icon"
                      aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        }
    </div>
}