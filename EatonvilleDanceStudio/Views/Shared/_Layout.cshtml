@using Microsoft.AspNetCore.Identity
@using EatonvilleDanceStudio.Data
@using EatonvilleDanceStudio.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    // Figure out the theme before the page even starts drawing
    // Prepped for the upcoming Parent and Dancer dashboards (Issues #67 & #68)
    string roleThemeClass = "";
    
    if (SignInManager.IsSignedIn(User))
    {
        if (User.IsInRole("Director"))
        {
            roleThemeClass = "theme-admin"; 
        }
        else if (User.IsInRole("Instructor"))
        {
            roleThemeClass = "theme-instructor";
        }
        else if (User.IsInRole("Parent"))
        {
            roleThemeClass = "theme-parent";
        }
        else if (User.IsInRole("Dancer"))
        {
            roleThemeClass = "theme-dancer";
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EatonvilleDanceStudio</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EatonvilleDanceStudio.styles.css" 
          asp-append-version="true" />
</head>
<!-- The calculated theme class controls the CSS layout -->
<body class="text-neon" style="background-color: #050505;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark 
                    bg-dark border-bottom border-neon box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-neon fw-bold fs-3" 
                   asp-area="" asp-controller="Home" asp-action="Index">
                   EatonvilleDanceStudio
                </a>
                <button class="navbar-toggler" type="button" 
                        data-bs-toggle="collapse" 
                        data-bs-target=".navbar-collapse" 
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex 
                            justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-neon fw-bold" 
                               asp-area="" asp-controller="Home" 
                               asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-neon fw-bold" 
                               asp-area="" asp-controller="Class" 
                               asp-action="Index">Classes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="VideoVault"
                               asp-action="Index">
                                Video Vault
                            </a>
                        </li>
                        <!-- Dynamic Dashboard Routing -->
                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Director"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-neon fw-bold" 
                                       asp-controller="Director" 
                                       asp-action="ManageUsers">Dashboard</a>
                                </li>
                            }
                            else if (User.IsInRole("Instructor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-neon fw-bold" 
                                       asp-controller="Instructor" 
                                       asp-action="Dashboard">Dashboard</a>
                                </li>
                            }
                            else if (User.IsInRole("Parent"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-neon fw-bold" 
                                       asp-controller="Parent" 
                                       asp-action="Dashboard">Dashboard</a>
                                </li>
                            }
                            else if (User.IsInRole("Dancer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-neon fw-bold" 
                                       asp-controller="Dancer" 
                                       asp-action="Dashboard">Dashboard</a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top-neon footer text-neon">
        <div class="container">
            &copy; 2026 - EatonvilleDanceStudio - 
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>